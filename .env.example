# From console.x.com -> your App -> Keys and tokens -> OAuth 2.0 Client ID and Client Secret
X_CLIENT_ID=
X_CLIENT_SECRET=

# Must match EXACTLY one of the Callback URIs registered on your X app
# Local: http://127.0.0.1:3000/api/auth/callback  (X rejects "localhost" in some cases; 127.0.0.1 is safest)
X_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# 32+ random characters, used to encrypt the session cookie (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Cost guard: max X API timeline pages fetched per /api/feed call (each page = up to 100 billable post reads)
MAX_PAGES_PER_REQUEST=2
